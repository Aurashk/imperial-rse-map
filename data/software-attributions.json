  "meta": {
    "description": "Rules that attribute research software repositories to Imperial departments. The Imperial Research Software Directory does not record a department, so attributions are inferred from the owning GitHub account or research group and must be verified.",
    "lastReviewed": "2026-11-10",
    "precedence": "A rule under 'repos' (keyed by 'owner/name') overrides a rule under 'owners' (keyed by GitHub account). Matching is case-insensitive.",
    "fields": {
      "departments": "Department ids from departments.json. Use an empty list with \"central\": true for software owned by the central RSE / Research Computing Service.",
      "group": "Research group, lab or centre the attribution is based on.",
      "confidence": "high = owning group is well known to sit in the department; medium = likely but unconfirmed; low = best guess.",
      "rseInvolved": "Optional. true when the central RSE team has worked on the software (for example a project or open-source booster). Such packages are excluded from the map's 'no RSE involvement' ring and tagged instead."
    }
